    },
    "inner-play.index.text.0002": {
      "value": "Zum Hauptinhalt springen",
      "sourceSha256": "c887f134c26ea8310e1fb4bd6fbab7b640393bd1b556e62691c7a442be92ec2a"
    },
    "inner-play.index.text.0003": {
      "value": "Navigation öffnen",
      "sourceSha256": "0ed77fd2619ba8ab3e1cce72c8e61d887d551ca1220164b88ab1aa66bba7177d"
    },
    "inner-play.index.text.0004": {
      "value": "Die Objekte",
      "sourceSha256": "5bc7872272afd8ba3ba1c05870da3f4fc3bbcf6dd322c5e026bf4439026e969d"
    },
    "inner-play.index.text.0005": {
      "value": "Wie sie antworten",
      "sourceSha256": "3efbad1166e24b20fc6f094c135757275e9b2d3f73bd5adfa6e91b073965d30f"
    },
    "inner-play.index.text.0006": {
      "value": "Für deine Sinne geschaffen",
      "sourceSha256": "b84c66fcafaa7956dacc09c702469f50db7c8e70157a906b2d5f145517c33047"
    },
    "inner-play.index.text.0007": {
      "value": "Verfügbarkeit",
      "sourceSha256": "12f67f8539c46701e62d1c50254cf025c22a992b06fea6d4c0e19705f21f4cac"
    },
    "inner-play.index.text.0008": {
      "value": "Alle Apps",
      "sourceSha256": "01bed311e7d0c963a5f8afe3dd3c99c8140d887d92c602b94b9309fa51b32723"
    },
    "inner-play.index.text.0009": {
      "value": "Vorläufiges Symbol",
      "sourceSha256": "274c846c048c2a41dc6b42e06566ba3382ce3fb84dfc08f99988256163239857"
    },
    "inner-play.index.text.0010": {
      "value": "Etwas für deine Hände. Raum für deinen Geist.",
      "sourceSha256": "1e63725203af3e1af776567c24098ee517d7538df15927dccd0803a26894bf3e"
    },
    "inner-play.index.text.0011": {
      "value": "Demnächst verfügbar",
      "sourceSha256": "4f7d64017689437e6d93f5724f3f797054f3935d98a13148025b616b8db8fb2c"
    },
    "inner-play.index.text.0012": {
      "value": "Das Kabinett öffnen",
      "sourceSha256": "93e924dc46f16b46a3b770c5b266ac33843ebf22f44555fb5c3872c537251c2b"
    },
    "inner-play.index.text.0013": {
      "value": "scrolle, um hineinzugreifen",
      "sourceSha256": "8f336d19683904f742f433aaea302d1def507141ae130922089f08ecc347f188"
    },
    "inner-play.index.text.0014": {
      "value": "Wie eine Schublade voller gut gefertigter Gegenstände in einem stillen Raum zu öffnen.",
      "sourceSha256": "5db4c5c321574b3d84417deda987ed7f1ac4c40d00873015f2ec3a04b1fedb9d"
    },
    "inner-play.index.text.0015": {
      "value": "Inner Play ist ein kleines Kabinett taktiler digitaler Objekte. Dreh etwas, das Gewicht hat. Überschreite den Druckpunkt eines Schalters. Drehe, schiebe, drücke, halte und lass los — und spüre, wie das Objekt ehrlich antwortet.",
      "sourceSha256": "802ec657bd062bb1962bfb1dae2866cc8b4c9e4069660fd974f42e21a72b383c"
    },
    "inner-play.index.text.0016": {
      "value": "Keine Aufgabe. Keine Lektion. Kein Punktestand, den es zu verbessern gilt. Einfach ein Ort für die Hände.",
      "sourceSha256": "e41c17a93bf25b041a30e52b7e92f27883ad5f5b998d3ba0eed65cb7fc90cf68"
    },
    "inner-play.index.text.0017": {
      "value": "Drehen",
      "sourceSha256": "b9e96ae52a7b7115022a979b3151221b0e6e9ce0c219933b2d84b29a7f47ecc7"
    },
    "inner-play.index.text.0018": {
      "value": "Schalten",
      "sourceSha256": "39921a740bf2b67802a2042e1f87e9dec566131c2458aba5683e2827ced0d2c3"
    },
    "inner-play.index.text.0019": {
      "value": "Schieben",
      "sourceSha256": "6bb4c1177681ec4eb53bb315e71185f702e52f845cc7ff3ae114c41464f67510"
    },
    "inner-play.index.text.0020": {
      "value": "Drücken und halten",
      "sourceSha256": "bbe7c64270b743d430f3157ae9aa650628c766b7d602c07f7d0a93b4a6170835"
    },
    "inner-play.index.text.0021": {
      "value": "Glaubt die Hand daran?",
      "sourceSha256": "91129933a4859b62dcef77c38ac917944522342c3de11df45f1b7eb101fc157d"
    },
    "inner-play.index.text.0022": {
      "value": "Jede Reaktion entsteht aus demselben physikalischen Zustand.",
      "sourceSha256": "59e5b2b1cb1b4330534905a613def7c9dc263432a8ee8ca37ec5cf590fdacf51"
    },
    "inner-play.index.text.0023": {
      "value": "Ein Objekt fühlt sich echt an, wenn Bewegung, Widerstand, Klang, Haptik und sichtbarer Zustand übereinstimmen. Inner Play wird so gebaut, dass Berührung die Reaktion erzeugt — nicht eine vorgefertigte Animation, die nur so tut.",
      "sourceSha256": "2a1f0e5623bc4f611b63c4849c5ec809121069bad9a276b1c03359b8db72bdad"
    },
    "inner-play.index.text.0024": {
      "value": "Bewegung mit Folgen",
      "sourceSha256": "6da32e3325c6ef6f21923ed4679039d9409d1d496b606b8a417edd106175d5c2"
    },
    "inner-play.index.text.0025": {
      "value": "Schwung, Druckpunkte, Weg, Reibung und Ruhe gehören zum Objekt.",
      "sourceSha256": "60e30d7e519b0ea0f10db38f84d906488b243fc73c4a284de1500d98374ede66"
    },
    "inner-play.index.text.0026": {
      "value": "Klang aus Bewegung",
      "sourceSha256": "a330a7e298bec223b07141b0a8dbf742fbeff45eafecc9a7e20d8d7db50ca5b9"
    },
    "inner-play.index.text.0027": {
      "value": "Geschwindigkeit, Kontakt und Position bestimmen, was du hörst und wann du es hörst.",
      "sourceSha256": "91977e5e27fd0e74dad65177b3752f4bb637fc431c192cece3df3192d0928925"
    },
    "inner-play.index.text.0028": {
      "value": "Haptik mit Sinn",
      "sourceSha256": "75ed19fcbb43677083e26b09fe24a2b41439439ca8c637bc6cb1ff4b8e01f3ff"
    },
    "inner-play.index.text.0029": {
      "value": "Rastpunkte, Textur, Betätigung und Loslassen sind in den entscheidenden Momenten spürbar.",
      "sourceSha256": "6bc66fa456f253c1b70c69206b8951884906faa6524a6237461f006b8dcd7381"
    },
    "inner-play.index.text.0030": {
      "value": "Ein Zustand, der wahr bleibt",
      "sourceSha256": "b59085479459fdbf015393f7bfb7621eb72395640ca9d51362cdfd59db6bd6c8"
    },
    "inner-play.index.text.0031": {
      "value": "Das Objekt bleibt dort, wo die Interaktion es zurückgelassen hat, bis sich wieder etwas bewegt.",
      "sourceSha256": "caed652c4e71d16c28992db1923434d0369bbdf66e4824906ed4171a810ec831"
    },
    "inner-play.index.text.0032": {
      "value": "Spielen ohne Druck",
      "sourceSha256": "35f3fbb5f7ff4aaee2bc89bec852b1a984dd885f03201f8da32ba018c3cf8fdd"
    },
    "inner-play.index.text.0033": {
      "value": "Keine Serien. Keine Punkte. Keine Forderung, zurückzukehren.",
      "sourceSha256": "af4422aa4c0ee29e357ddb139ccc7eff2a3da2368f9a831c33e2a31e0b609b27"
    },
    "inner-play.index.text.0034": {
      "value": "Inner Play kann erfüllend sein, ohne laut zu werden, und spielerisch, ohne kindisch zu wirken. Öffne das Kabinett, nutze, was sich richtig anfühlt, und geh ohne Nachteil wieder.",
      "sourceSha256": "9c8c6c0dbbbbca94db11333aa6f9532e998e4e97c54e63c7a00d724bbb7f7afc"
    },
    "inner-play.index.text.0035": {
      "value": "Es bietet sinnliches Spiel und konzentrationsfreundliche Interaktion, ohne medizinische Versprechen zu machen.",
      "sourceSha256": "efc98fff0cc4299332ffea1c98715a9b2775274b07b1eea1b76c9c48d528c266"
    },
    "inner-play.index.text.0036": {
      "value": "Für deine Sinne geschaffen",
      "sourceSha256": "b84c66fcafaa7956dacc09c702469f50db7c8e70157a906b2d5f145517c33047"
    },
    "inner-play.index.text.0037": {
      "value": "Reichhaltig, wenn du es möchtest. Vollständig, wenn etwas ausgeschaltet ist.",
      "sourceSha256": "25501c6145841353f5fd5ea861fab762c547befed74b9d1b1c9671f76485236c"
    },
    "inner-play.index.text.0038": {
      "value": "Klang und Haptik erhalten unabhängige Regler. Stille ist ein vollständiger Modus. Bewegung reduzieren bewahrt verständliche Ursache und Wirkung mit weniger fortlaufender Bewegung. VoiceOver beschreibt das Objekt, seinen Zustand und sinnvolle Möglichkeiten, darauf einzuwirken.",
      "sourceSha256": "69c21a287d89e67dd5e37000d6ab699eeb96b1d174d72f2758999dbc9f4cb7cd"
    },
    "inner-play.index.text.0039": {
      "value": "Kein Zustand hängt ausschließlich von Farbe, Klang, Bewegung, Sehen oder haptischer Rückmeldung ab.",
      "sourceSha256": "9562221efccef2bf8fdd8cb78b4ab894b2822b3affd2e1f0a2f7a89c7bbddb23"
    },
    "inner-play.index.text.0040": {
      "value": "Jedes Hauptobjekt bleibt auch bei ausgeschaltetem Klang oder deaktivierter Haptik nutzbar.",
      "sourceSha256": "0d07f68208ee3cfadb3af7947e50e9ed9022e474619d2f3c2a08d7debd5cdad6"
    },
    "inner-play.index.text.0041": {
      "value": "Berührungsziele und alternative Aktionen gehören von Anfang an zum Objekt.",
      "sourceSha256": "f2b2e15bb80e768b0d1419a6507a3334df7d3dab55b6be4187ff4b88c6fdd710"
    },
    "inner-play.index.text.0042": {
      "value": "Barrierefreiheit gehört zur Entscheidung darüber, was das Objekt ist — sie wird nicht nachträglich darumgelegt.",
      "sourceSha256": "5021611c5274d93e515fe5a076820e75a5c10aaa88259d4e51e72c6f4b313ba1"
    },
    "inner-play.index.text.0043": {
      "value": "Eine Intention für Inner Play",
      "sourceSha256": "da542a347a2759ed5ad41e1903cdd29bca09bc7d319777c66c4c91412225a572"
    },
    "inner-play.index.text.0044": {
      "value": "Möge jedes Objekt der Hand ehrlich antworten.",
      "sourceSha256": "87c5c9d59571afb3f52c0400fd8f5bade067e726879782ad1d4e37feccef2d9e"
    },
    "inner-play.index.text.0045": {
      "value": "Möge Bewegung Raum schaffen, ohne etwas zu fordern.",
      "sourceSha256": "bf3b641d21f364286855dc1a6b74b998eb7a6acc787b187848e9f9cb40fef867"
    },
    "inner-play.index.text.0046": {
      "value": "Möge das Spiel einfach, würdevoll und frei bleiben.",
      "sourceSha256": "e1e64fd70eab75c05ac77e2e1c88af6411ccd8e4f635f4a2fb3d131e80489b93"
    },
    "inner-play.index.text.0047": {
      "value": "von Moving Truth",
      "sourceSha256": "3daa3456fa0b55162e7c72b8d69a3fff181d034edf3423bcf3ce5a972cf2aab4"
    },
    "inner-play.index.text.0048": {
      "value": "Mit Liebe geschaffen von Skylaur Roe",
      "sourceSha256": "8973d1d4a4d34a688cb6e6d9080ec19b076e65b44fac74776e850e1cfb0f6562"
    },
    "inner-play.index.text.0049": {
      "value": "Alle Moving-Truth-Apps entdecken",
      "sourceSha256": "1a8f383841d7faff0dd5d4232e122c1fc9c9cd70a6081e1df6caffd492edc277"
    },
    "inner-play.index.text.0050": {
      "value": "Demnächst verfügbar",
      "sourceSha256": "4f7d64017689437e6d93f5724f3f797054f3935d98a13148025b616b8db8fb2c"
    },
    "inner-play.index.text.0051": {
      "value": "Die ersten Objekte nehmen Gestalt an.",
      "sourceSha256": "37b2cb01e904685f7ea374320b186c906d118020c1a0899bff57b234a09e232a"
    },
    "inner-play.index.text.0052": {
      "value": "Inner Play wird nativ für iPhone entwickelt. Der erste Beweis beginnt mit einem glaubwürdigen Drehrad und einem physischen Schalter, bevor das Kabinett wächst.",
      "sourceSha256": "3c4caa23850544e807e6efbeb7d1c6c7d72702f69e407cbb42debfa0816c3c0f"
    },
    "inner-play.index.text.0053": {
