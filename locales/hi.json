      "sourceSha256": "3daa3456fa0b55162e7c72b8d69a3fff181d034edf3423bcf3ce5a972cf2aab4"
    },
    "inner-play.index.text.0048": {
      "value": "Skylaur Roe द्वारा प्यार से बनाया गया",
      "sourceSha256": "8973d1d4a4d34a688cb6e6d9080ec19b076e65b44fac74776e850e1cfb0f6562"
    },
    "inner-play.index.text.0049": {
      "value": "सभी Moving Truth ऐप्स देखें",
      "sourceSha256": "1a8f383841d7faff0dd5d4232e122c1fc9c9cd70a6081e1df6caffd492edc277"
    },
    "inner-play.index.text.0050": {
      "value": "जल्द आ रहा है",
      "sourceSha256": "4f7d64017689437e6d93f5724f3f797054f3935d98a13148025b616b8db8fb2c"
    },
    "inner-play.index.text.0051": {
      "value": "पहली वस्तुएँ आकार ले रही हैं।",
      "sourceSha256": "37b2cb01e904685f7ea374320b186c906d118020c1a0899bff57b234a09e232a"
    },
    "inner-play.index.text.0052": {
      "value": "Inner Play को iPhone के लिए मूल रूप से बनाया जा रहा है। अलमारी बढ़ने से पहले इसकी पहली परीक्षा एक विश्वसनीय घूमने वाले पहिए और एक भौतिक स्विच से शुरू होती है।",
      "sourceSha256": "3c4caa23850544e807e6efbeb7d1c6c7d72702f69e407cbb42debfa0816c3c0f"
    },
    "inner-play.index.text.0053": {
      "value": "Inner Play के बारे में पूछें",
      "sourceSha256": "699e474a0dbf07560a472f30bc8cbfad9e5ba97ae4af089359b441a8984df6f7"
    },
