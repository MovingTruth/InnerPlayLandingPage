      "sourceSha256": "3efbad1166e24b20fc6f094c135757275e9b2d3f73bd5adfa6e91b073965d30f"
    },
    "inner-play.index.text.0056": {
      "value": "सुगम्यता",
      "sourceSha256": "d3368cbffe23c98da887d279a1b5c74b7618ba5c0488cbed30cf304f8f9398a1"
    },
    "inner-play.index.text.0057": {
